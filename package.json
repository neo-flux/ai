{
  "name": "@neoflux/ai",
  "version": "0.0.0",
  "description": "Provider-neutral TypeScript library for calling LLMs",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "bun test",
    "pack:check": "bun scripts/pack-check.ts",
    "smoke": "bun scripts/smoke.ts",
    "mutate": "bun scripts/mutate.ts test/mutants/core.json test/mutants/guards.json",
    "check": "bun run typecheck && bun run lint && bun run test && bun run pack:check && bun run smoke"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^1.0.0",
    "openai": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "trustedDependencies": [],
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.8",
    "@standard-schema/spec": "1.1.0",
    "@types/bun": "1.4.4",
    "@valibot/to-json-schema": "1.8.0",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "valibot": "1.5.0",
    "zod": "4.6.7"
  }
}
